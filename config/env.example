# Flask Configuration
# ===================
# FLASK_DEBUG: Enable debug mode (True) or production mode (False)
# - True: Shows detailed errors, auto-reloads on code changes (development)
# - False: Generic errors, no auto-reload (production)
FLASK_DEBUG=False

# SECRET_KEY: Flask secret key for cryptographic operations (sessions, CSRF, tokens)
# ⚠️  IMPORTANT: Change this to a secure random string in production!
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# HOST: Server host address
# - localhost: Only accessible from this machine
# - 0.0.0.0: Accessible from network (for remote access)
HOST=localhost

# PORT: Server port number
PORT=5001

# Storage Paths (Use forward slashes for cross-platform compatibility)
STORAGE_DIR=storage
DOCUMENTS_DIR=storage/documents
CHROMA_DB_DIR=storage/chroma_db
EMBEDDING_CACHE_DIR=storage/embedding_cache

# RAG Configuration
# =================
# COLLECTION_NAME: ChromaDB collection name for storing document embeddings
COLLECTION_NAME=rag_collection

# CHUNK_SIZE: Size of text chunks when splitting documents (characters)
# Larger chunks = more context, but may miss details
# Smaller chunks = more granular, but may lose context
CHUNK_SIZE=1000

# CHUNK_OVERLAP: Overlap between chunks (characters)
# Helps maintain context across chunk boundaries
CHUNK_OVERLAP=200

# RETRIEVAL_K: Number of document chunks to retrieve per query
# More chunks = more context, but slower and potentially less focused
RETRIEVAL_K=3

# MIN_SIMILARITY_THRESHOLD: Minimum similarity percentage (0-100) to include a source
# Lower = more results (may include less relevant), Higher = fewer results (more relevant)
MIN_SIMILARITY_THRESHOLD=15.0

# LLM Configuration
# =================
# USE_LOCAL_EMBEDDINGS: Use local embeddings (True) or OpenAI embeddings (False)
# - True: Free, private, runs locally (HuggingFace model)
# - False: Uses OpenAI API (costs money, sends data to OpenAI)
USE_LOCAL_EMBEDDINGS=True

# LLM_PROVIDER: Language model provider ("ollama" or "openai")
# - ollama: Local LLM (free, private, requires Ollama installed)
# - openai: OpenAI API (costs money, requires API key)
LLM_PROVIDER=ollama

# Option 1: OpenAI Configuration
# ------------------------------
# Only set this if you want to use OpenAI (and set LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key-here
# Note: When using OpenAI, set USE_LOCAL_EMBEDDINGS=False

# Option 2: Ollama Configuration (Local - Recommended)
# ----------------------------------------------------
# OLLAMA_BASE_URL: Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# OLLAMA_MODEL: Ollama model to use (default: llama3.2:3b)
# Available models: llama3.2:3b, llama3.2:1b, mistral, etc.
# Pull a model: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# Advanced Features
# =================
# USE_HYBRID_SEARCH: Combine semantic search with keyword search (BM25)
# - True: Better results but slower
# - False: Faster semantic search only
USE_HYBRID_SEARCH=False

# USE_RERANKING: Re-rank results using CrossEncoder model
# - True: Better relevance but slower
# - False: Use similarity scores only
USE_RERANKING=False

# USE_QUERY_EXPANSION: Expand queries with related terms
# - True: Better for complex queries
# - False: Use original query only
USE_QUERY_EXPANSION=False

# Caching
# =======
# ENABLE_QUERY_CACHE: Cache query results for faster responses
# - True: Faster repeated queries
# - False: Always fresh results
ENABLE_QUERY_CACHE=True

# QUERY_CACHE_SIZE: Maximum number of cached queries
QUERY_CACHE_SIZE=1000

# ENABLE_EMBEDDING_CACHE: Cache document embeddings to avoid recomputation
# - True: Faster document processing (recommended)
# - False: Recompute embeddings every time
ENABLE_EMBEDDING_CACHE=True

# Admin Configuration
# ADMIN_UPLOAD_MAX_SIZE_MB: Maximum file upload size in megabytes
ADMIN_UPLOAD_MAX_SIZE_MB=50

